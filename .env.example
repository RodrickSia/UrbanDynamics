# Local defaults; replace values for your environment.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Set these when selecting and configuring the warehouse.
WAREHOUSE_HOST=
WAREHOUSE_PORT=
WAREHOUSE_DATABASE=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=

# Khoi owns citywide rainfall ETL. Sampling spacing is not native model resolution.
HCMC_BOUNDARY=data/inputs/hcmc_expanded_boundary.geojson
RAIN_GRID_M=10000
RAIN_BATCH_SIZE=10
RAIN_HISTORY_START_YEAR=2016
# Empty: use the previous complete calendar year.
RAIN_HISTORY_END_YEAR=
RAIN_HISTORY_STATIONS_PER_RUN=4
RAIN_REFRESH_SECONDS=3600
RAIN_HISTORY_REFRESH_SECONDS=300
SATELLITE_REFRESH_SECONDS=21600
FLOOD_HISTORY_REFRESH_SECONDS=604800
LAND_PRICE_REFRESH_SECONDS=2592000
