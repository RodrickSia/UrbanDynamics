# Local defaults; replace values for your environment.
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_GOONG_MAPTILES_KEY=
VITE_API_BASE_URL=http://localhost:8000

# Local PostGIS connection defaults. Change the password outside local development.
# Compose overrides the host to `postgis` for containers; use localhost from the host.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=urbandynamics
WAREHOUSE_USER=urbandynamics
WAREHOUSE_PASSWORD=localdev
WAREHOUSE_FORWARD_PORT=5432
