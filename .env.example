# Local defaults; replace values for your environment.
FRONTEND_PORT=8080
VITE_GOONG_MAPTILES_KEY=
VITE_API_BASE_URL=

# Set a unique PostGIS password before starting the database (no shared default).
# Containers connect to PostGIS at `postgis:5432` over the Compose network.
WAREHOUSE_HOST=postgis
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=urbandynamics
WAREHOUSE_USER=urbandynamics
WAREHOUSE_PASSWORD=
