# Local environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
etl/data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.runtime/
output/
data/
# Keep the official land-price annex available to local and CI ETL runs.
!etl/data/
etl/data/*
!etl/data/raw/
etl/data/raw/*
!etl/data/raw/land_price/
etl/data/raw/land_price/*
!etl/data/raw/land_price/official-annex-2026.pdf
# Keep the downloaded HCMC parcel tiles and sample GeoJSON.
!etl/data/parcels_hcmc/
# Keep the pinned HCMC boundary; generated Overture Parquet stays ignored.
!etl/data/buildings_footprint/
etl/data/buildings_footprint/*
!etl/data/buildings_footprint/hcmc_boundary.geojson
# Keep the historical HCMC traffic input and its directory placeholder.
!etl/data/traffic_history/
etl/data/traffic_history/*
!etl/data/traffic_history/.gitkeep
!etl/data/traffic_history/traffic.csv
# Keep the TomTom traffic input snapshot in git; generated observations stay local.
!etl/data/road_data_tomtom/
etl/data/road_data_tomtom/*
!etl/data/road_data_tomtom/.gitkeep
!etl/data/road_data_tomtom/tomtom_hcmc_traffic_sample.csv
# Keep the cropped HCMC OSM input in git; large source and generated files stay local.
!etl/data/osm_sumo_hcmc/
etl/data/osm_sumo_hcmc/*
!etl/data/osm_sumo_hcmc/.gitkeep
!etl/data/osm_sumo_hcmc/hcmc.osm.pbf
test-results/

